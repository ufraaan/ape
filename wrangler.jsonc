{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ape",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-22",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ape",
      "database_id": "",
      "migrations_dir": "migrations"
    }
  ]
}
