{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ape",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-22",
  "build": {
    "command": "npm run build:scripts && npm run build:styles",
    "watch_dir": ["src", "scripts"]
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "vars": {
    "TURNSTILE_SITE_KEY": "",
    "ABUSE_EMAIL": "naarfu@gmail.com"
  },
  "ratelimits": [
    {
      "name": "CREATE_RATE_LIMIT",
      "namespace_id": "1001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    {
      "name": "READ_RATE_LIMIT",
      "namespace_id": "1002",
      "simple": {
        "limit": 120,
        "period": 60
      }
    }
  ],
  "routes": [
    {
      "pattern": "ape.ufraan.dev",
      "custom_domain": true
    }
  ],
  "triggers": {
    "crons": ["17 * * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ape",
      "database_id": "000d5e97-1297-4e0a-9522-df00ec27c165",
      "migrations_dir": "migrations"
    }
  ]
}
