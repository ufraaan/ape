{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ape",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-22",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "vars": {
    "TURNSTILE_SITE_KEY": "",
    "ABUSE_EMAIL": "naarfu@gmail.com"
  },
  "ratelimits": [
    {
      "name": "CREATE_RATE_LIMIT",
      "namespace_id": "1001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ],
  "triggers": {
    "crons": ["17 * * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ape",
      "database_id": "",
      "migrations_dir": "migrations"
    }
  ]
}
