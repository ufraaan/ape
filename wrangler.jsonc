{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ape",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-22",
  "build": {
    "command": "npm run build:scripts && npm run build:styles",
    "watch_dir": ["src", "scripts"]
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "vars": {
    "TURNSTILE_SITE_KEY": "",
    "ABUSE_EMAIL": "ape@ufraan.dev"
  },
  "ratelimits": [
    {
      "name": "CREATE_RATE_LIMIT",
      "namespace_id": "1001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    {
      "name": "READ_RATE_LIMIT",
      "namespace_id": "1002",
      "simple": {
        "limit": 120,
        "period": 60
      }
    }
  ],
  "routes": [
    {
      "pattern": "ape.ufraan.dev",
      "custom_domain": true
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "PASTES",
        "class_name": "PasteStore"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["PasteStore"]
    }
  ]
}
