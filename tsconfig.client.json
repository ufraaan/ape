{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "types": [],
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": [
    "src/client/**/*.ts",
    "scripts/highlight-auto.ts",
    "scripts/paste-highlight.ts",
    "types/**/*.d.ts"
  ]
}
